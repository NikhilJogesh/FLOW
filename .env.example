# VERCEL POSTGRES DATABASE
# You must provision a Vercel Postgres database in the Vercel Dashboard for deployment.
# Vercel will automatically inject these variables into your deployment environment.

# For LOCAL development, you need a PostgreSQL database.
# You can use Docker: docker run --name flow-db -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres
# Then use these connection strings:

POSTGRES_PRISMA_URL="postgresql://postgres:postgres@localhost:5432/postgres?schema=public"
POSTGRES_URL_NON_POOLING="postgresql://postgres:postgres@localhost:5432/postgres?schema=public"
